{
  "name": "kera",
  "version": "0.1.0",
  "description": "Personal AI assistant on Telegram, backed by a local Ollama model",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:watch": "vitest --exclude \"**/*.integration.test.ts\"",
    "test:ollama": "vitest run src/ai/ollamaClient.integration.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "zod": "^4.6.7"
  }
}
