# Copy this file to .env and fill in real values. Never commit .env.

# Bot token from @BotFather, format "<digits>:<secret>". Required.
# Treat it like a password. If it leaks, revoke it in @BotFather with /revoke.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot, e.g. 123456789,987654321
# Leave empty on first setup: every user is ignored and their ID is printed to the
# console, so you can copy your own ID from there.
ALLOWED_USER_IDS=
