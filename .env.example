# Copy this file to .env and fill in real values. Never commit .env.
# Empty values are treated as "not set", so the default applies.

# Bot token from @BotFather, format "<digits>:<secret>". Required.
# Treat it like a password. If it leaks, revoke it in @BotFather with /revoke.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot, e.g. 123456789,987654321
# Leave empty on first setup: every user is ignored and their ID is printed to the
# console, so you can copy your own ID from there.
ALLOWED_USER_IDS=

# Ollama server. Keep it on localhost: the Ollama API has no authentication.
# Default: http://127.0.0.1:11434
OLLAMA_BASE_URL=

# Model name as shown by `ollama list`. Default: qwen3:4b-instruct
OLLAMA_MODEL=

# "true" only for thinking models (e.g. qwen3:4b) so reasoning is returned separately
# and never shown to the user. Default: false
OLLAMA_THINK=

# Max time to wait for one answer, in milliseconds (1000 - 600000). Default: 120000
OLLAMA_TIMEOUT_MS=
